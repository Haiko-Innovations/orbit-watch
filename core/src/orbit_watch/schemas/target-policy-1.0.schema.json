{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Haiko-Innovations/orbit-watch/schemas/target-policy-1.0.schema.json",
  "title": "Orbit Watch target policy (allow-list), format version 1.0",
  "description": "Objects that requests may target. Everything else is refused. Build it from civilian groups of the public GP catalogue (see docs/verification.md).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "allow"
  ],
  "properties": {
    "format": {
      "const": "orbit-watch/target-policy"
    },
    "format_version": {
      "const": "1.0"
    },
    "simulated": {
      "type": "boolean"
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "built_from": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "allow": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "norad_id"
        ],
        "properties": {
          "norad_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999999999
          },
          "name": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    }
  }
}
