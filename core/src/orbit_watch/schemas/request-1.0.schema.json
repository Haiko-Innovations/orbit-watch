{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Haiko-Innovations/orbit-watch/schemas/request-1.0.schema.json",
  "title": "Orbit Watch observation request, format version 1.0",
  "description": "What a requester asks for: one target object, a time window and delivery requirements. Phase 0 uses requests only as verification input; the request lifecycle comes in phase 1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "simulated",
    "request_id",
    "target",
    "window",
    "requirements"
  ],
  "properties": {
    "format": {
      "const": "orbit-watch/request"
    },
    "format_version": {
      "const": "1.0"
    },
    "simulated": {
      "type": "boolean"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$"
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "norad_id"
      ],
      "properties": {
        "norad_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999999999
        },
        "name": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
        },
        "end": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_observations",
        "max_angle_uncertainty_arcsec",
        "max_time_uncertainty_s"
      ],
      "properties": {
        "min_observations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "max_angle_uncertainty_arcsec": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_time_uncertainty_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "angle_types": {
          "type": "array",
          "items": {
            "enum": [
              "radec",
              "azel"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  }
}
