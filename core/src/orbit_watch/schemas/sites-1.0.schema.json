{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Haiko-Innovations/orbit-watch/schemas/sites-1.0.schema.json",
  "title": "Orbit Watch station sites file, format version 1.0",
  "description": "Station coordinates for formats that only carry a station identifier, such as IOD (four-digit station number) and CCSDS TDM (PARTICIPANT_1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "sites"],
  "properties": {
    "format": { "const": "orbit-watch/sites" },
    "format_version": { "const": "1.0" },
    "simulated": { "type": "boolean" },
    "sites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "latitude_deg", "longitude_deg", "altitude_m"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
          "name": { "type": "string", "maxLength": 200 },
          "latitude_deg": { "type": "number", "minimum": -90, "maximum": 90 },
          "longitude_deg": { "type": "number", "minimum": -180, "maximum": 180 },
          "altitude_m": { "type": "number", "minimum": -500, "maximum": 10000 },
          "iod_station_number": { "type": "integer", "minimum": 0, "maximum": 9999 },
          "simulated": { "type": "boolean" }
        }
      }
    }
  }
}
