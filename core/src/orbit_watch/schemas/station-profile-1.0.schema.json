{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Haiko-Innovations/orbit-watch/schemas/station-profile-1.0.schema.json",
  "title": "Orbit Watch simulated station profile, format version 1.0",
  "description": "Parameters of a SIMULATED observing station. Noise values are one-sigma.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "simulated",
    "id",
    "description",
    "station",
    "angle_type",
    "angle_noise_arcsec",
    "time_noise_s",
    "clock_offset_s",
    "declared_angle_uncertainty_arcsec",
    "declared_time_uncertainty_s",
    "cadence_s",
    "points_per_pass",
    "min_elevation_deg",
    "dropout_probability"
  ],
  "properties": {
    "format": {
      "const": "orbit-watch/station-profile"
    },
    "format_version": {
      "const": "1.0"
    },
    "simulated": {
      "const": true
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,64}$"
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "station": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "latitude_deg",
        "longitude_deg",
        "altitude_m"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,64}$"
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "latitude_deg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90,
          "description": "Geodetic latitude, WGS 84."
        },
        "longitude_deg": {
          "type": "number",
          "minimum": -180,
          "maximum": 180,
          "description": "Longitude, east positive, WGS 84."
        },
        "altitude_m": {
          "type": "number",
          "minimum": -500,
          "maximum": 10000,
          "description": "Height above the WGS 84 ellipsoid in metres."
        },
        "iod_station_number": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        }
      }
    },
    "angle_type": {
      "enum": [
        "radec",
        "azel"
      ]
    },
    "frame": {
      "enum": [
        "ICRF",
        "of-date"
      ]
    },
    "angle_noise_arcsec": {
      "type": "number",
      "minimum": 0,
      "maximum": 36000
    },
    "time_noise_s": {
      "type": "number",
      "minimum": 0,
      "maximum": 60
    },
    "clock_offset_s": {
      "type": "number",
      "minimum": -60,
      "maximum": 60
    },
    "declared_angle_uncertainty_arcsec": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 648000
    },
    "declared_time_uncertainty_s": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 3600
    },
    "cadence_s": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 3600
    },
    "points_per_pass": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "min_elevation_deg": {
      "type": "number",
      "minimum": 0,
      "maximum": 89
    },
    "dropout_probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.9
    }
  },
  "if": {
    "properties": {
      "angle_type": {
        "const": "radec"
      }
    }
  },
  "then": {
    "required": [
      "frame"
    ]
  }
}
