{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Haiko-Innovations/orbit-watch/schemas/request-1.1.schema.json",
  "title": "Orbit Watch observation request, format version 1.1",
  "description": "What a requester asks for: one target object, a time window and delivery requirements. Phase 0 uses requests only as verification input; the request lifecycle comes in phase 1. Version 1.1 adds replay: a request that an administrator creates to replay observations that someone else published, delivered by the replay station it names.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "simulated",
    "request_id",
    "target",
    "window",
    "requirements",
    "replay"
  ],
  "properties": {
    "format": {
      "const": "orbit-watch/request"
    },
    "format_version": {
      "const": "1.1"
    },
    "simulated": {
      "type": "boolean"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$"
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "norad_id"
      ],
      "properties": {
        "norad_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999999999
        },
        "name": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
        },
        "end": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_observations",
        "max_angle_uncertainty_arcsec",
        "max_time_uncertainty_s"
      ],
      "properties": {
        "min_observations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "max_angle_uncertainty_arcsec": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_time_uncertainty_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "angle_types": {
          "type": "array",
          "items": {
            "enum": [
              "radec",
              "azel"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "replay": {
      "type": "object",
      "description": "A replay (decision P5-10): the published observations it replays, by their SHA-256, the station that delivers them, and their source, observers and licence. Added in format 1.1.",
      "additionalProperties": false,
      "required": [
        "station",
        "observations_sha256",
        "source",
        "licence",
        "observers"
      ],
      "properties": {
        "station": {
          "type": "string",
          "pattern": "^station:.{1,120}$",
          "description": "The replay station that delivers the observations; it is never their observer."
        },
        "observations_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "The SHA-256 of the observation file that the replay delivers."
        },
        "source": {
          "type": "string",
          "maxLength": 200,
          "description": "Where the observations were published, e.g. the IAU CPS's SCORE."
        },
        "url": {
          "type": "string",
          "maxLength": 500,
          "pattern": "^https://"
        },
        "licence": {
          "type": "string",
          "maxLength": 100,
          "description": "An SPDX identifier, e.g. CC-BY-4.0."
        },
        "observers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "description": "The observers' ORCID iDs, as the source credits them.",
          "items": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X]$"
          }
        }
      }
    }
  }
}
