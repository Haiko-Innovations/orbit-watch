{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Haiko-Innovations/orbit-watch/schemas/observation-set-1.0.schema.json",
  "title": "Orbit Watch observation set, format version 1.0",
  "description": "Positional (angles-only) optical observations of one target object from one station. Times are UTC. Uncertainties are one-sigma estimates given by the observer.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "simulated", "station", "target", "observations"],
  "properties": {
    "format": { "const": "orbit-watch/observation-set" },
    "format_version": { "const": "1.0" },
    "simulated": {
      "type": "boolean",
      "description": "true when the observations come from a simulator and are not real measurements. Required so that simulated data can never be mistaken for real data."
    },
    "station": { "$ref": "#/$defs/station" },
    "target": { "$ref": "#/$defs/target" },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/observation" }
    },
    "source": {
      "type": "object",
      "description": "Free-form provenance: software, original format, notes.",
      "additionalProperties": false,
      "properties": {
        "software": { "type": "string", "maxLength": 200 },
        "converted_from": { "enum": ["iod", "ccsds-tdm"] },
        "original_designator": { "type": "string", "maxLength": 20 },
        "notes": { "type": "string", "maxLength": 2000 }
      }
    }
  },
  "$defs": {
    "station": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "latitude_deg", "longitude_deg", "altitude_m"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
        "name": { "type": "string", "maxLength": 200 },
        "latitude_deg": { "type": "number", "minimum": -90, "maximum": 90, "description": "Geodetic latitude, WGS 84." },
        "longitude_deg": { "type": "number", "minimum": -180, "maximum": 180, "description": "Longitude, east positive, WGS 84." },
        "altitude_m": { "type": "number", "minimum": -500, "maximum": 10000, "description": "Height above the WGS 84 ellipsoid in metres." },
        "iod_station_number": { "type": "integer", "minimum": 0, "maximum": 9999 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["norad_id"],
      "properties": {
        "norad_id": { "type": "integer", "minimum": 1, "maximum": 999999999 },
        "cospar_id": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{3}[A-Z]{1,3}$" },
        "name": { "type": "string", "maxLength": 200 }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time", "time_uncertainty_s", "angle_type", "angle_uncertainty_arcsec"],
      "properties": {
        "time": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
          "description": "UTC time of the measurement."
        },
        "time_uncertainty_s": { "type": "number", "exclusiveMinimum": 0, "maximum": 3600 },
        "angle_type": { "enum": ["radec", "azel"] },
        "frame": {
          "enum": ["ICRF", "of-date"],
          "description": "For radec only. ICRF: J2000 mean equator and equinox (IOD epoch code 5, TDM EME2000/ICRF). of-date: true equator and equinox of the observation date (IOD epoch code 0)."
        },
        "ra_deg": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
        "dec_deg": { "type": "number", "minimum": -90, "maximum": 90 },
        "az_deg": { "type": "number", "minimum": 0, "exclusiveMaximum": 360, "description": "Azimuth from north through east." },
        "el_deg": { "type": "number", "minimum": -90, "maximum": 90, "description": "Elevation above the horizon, no refraction correction assumed." },
        "angle_uncertainty_arcsec": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 648000,
          "description": "One-sigma uncertainty of each angle component, in arcseconds on the sky."
        },
        "magnitude": { "type": "number", "minimum": -30, "maximum": 30 }
      },
      "allOf": [
        {
          "if": { "properties": { "angle_type": { "const": "radec" } } },
          "then": {
            "required": ["frame", "ra_deg", "dec_deg"],
            "properties": { "az_deg": false, "el_deg": false }
          }
        },
        {
          "if": { "properties": { "angle_type": { "const": "azel" } } },
          "then": {
            "required": ["az_deg", "el_deg"],
            "properties": { "ra_deg": false, "dec_deg": false, "frame": false }
          }
        }
      ]
    }
  }
}
